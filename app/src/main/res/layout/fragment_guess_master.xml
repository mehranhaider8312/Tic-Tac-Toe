<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_guess_master"
    tools:context=".fragments.GuessMaster">

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test Your Mind Reading Skills"
        android:fontFamily="@font/poppins_bold"
        android:textSize="14sp"
        android:textColor="#7F8C8D"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Range Container with Card Style -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/rangeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvSetRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Set Number Range"
                android:fontFamily="@font/poppins_bold"
                android:textSize="18sp"
                android:textColor="#34495E"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etRangeMin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="Min (e.g., 1)"
                    android:textSize="16sp"
                    android:padding="14dp"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="#95A5A6"
                    android:background="@drawable/bg_edittext_numbers"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="to"
                    android:textSize="16sp"
                    android:textColor="#7F8C8D"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginEnd="12dp"/>

                <EditText
                    android:id="@+id/etRangeMax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="Max (e.g., 100)"
                    android:textSize="16sp"
                    android:padding="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="#95A5A6"
                    android:background="@drawable/bg_edittext_numbers" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Thinking Animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animThinkingMonkey"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="20dp"
        app:lottie_rawRes="@raw/thinking_monkey"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/cardRange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Guess Options Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGuess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardRange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guessContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Your Guess:"
                android:fontFamily="@font/poppins_bold"
                android:textSize="16sp"
                android:textColor="#34495E"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvGuessOne"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:text="25"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_guess_numbers"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvGuessTwo"
                app:layout_constraintWidth_percent="0.48"/>

            <TextView
                android:id="@+id/tvGuessTwo"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:text="50"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:layout_marginTop="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_guess_numbers"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvGuessOne"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.48"/>

            <TextView
                android:id="@+id/tvGuessThree"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:text="75"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_guess_numbers"
                app:layout_constraintTop_toBottomOf="@id/tvGuessOne"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvGuessFour"
                app:layout_constraintWidth_percent="0.48"/>

            <TextView
                android:id="@+id/tvGuessFour"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:text="90"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_guess_numbers"
                app:layout_constraintTop_toBottomOf="@id/tvGuessTwo"
                app:layout_constraintStart_toEndOf="@id/tvGuessThree"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.48"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Start/Restart Button -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="🚀 Start Game"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        android:backgroundTint="#E74C3C"
        android:textColor="#FFFFFF"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        android:elevation="6dp"
        app:cornerRadius="30dp"
        app:layout_constraintTop_toBottomOf="@id/animThinkingMonkey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Result Text -->
    <TextView
        android:id="@+id/tvResultText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Set your range and start guessing!"
        android:gravity="center"
        android:fontFamily="@font/agbalumo"
        android:textColor="#2C3E50"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:minHeight="80dp"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Fireworks Animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animFireWorks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:lottie_rawRes="@raw/fireworks"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>