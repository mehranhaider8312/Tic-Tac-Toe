<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:padding="9dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:elevation="1dp"
            android:background="@drawable/bg_circular_image"
            android:scaleType="centerCrop"
            android:src="@drawable/mehranhaider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/bg_contact_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.97">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/allan"
                android:text="@string/via_email"
                android:textColor="#2D2D2D"
                android:textSize="17sp"
                app:layout_constraintBottom_toTopOf="@id/animEmail"
                app:layout_constraintEnd_toEndOf="@id/animEmail"
                app:layout_constraintStart_toStartOf="@id/animEmail" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animEmail"
                android:layout_width="100dp"
                android:layout_height="60dp"
                app:lottie_rawRes="@raw/email_sent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/allan"
                android:text="@string/via_call"
                android:textColor="#E65100"
                android:textSize="17sp"
                app:layout_constraintBottom_toTopOf="@id/animCall"
                app:layout_constraintEnd_toEndOf="@id/animCall"
                app:layout_constraintStart_toStartOf="@id/animCall" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animCall"
                android:layout_width="100dp"
                android:layout_height="60dp"
                app:lottie_rawRes="@raw/call"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvContactMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/allan"
                android:text="@string/contact_nme"
                android:gravity="center"
                android:textColor="#7B1FA2"
                android:textSize="27sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/animCall"
                app:layout_constraintStart_toEndOf="@+id/animEmail" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>